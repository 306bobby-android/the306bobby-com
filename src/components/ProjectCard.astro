---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, tags, status, date } = project.data;
---

<article class="card">
  <div class="card-head">
    <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
    <span class="badge" data-status={status}>{status}</span>
  </div>
  <p class="card-summary">{summary}</p>
  <div class="card-foot">
    <time class="meta" datetime={date.toISOString()}>
      {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' })}
    </time>
    {tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 18px 20px;
    transition: border-color 0.15s ease;
  }
  .card:hover { border-color: var(--border-strong); }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .card-head h3 { margin: 0; font-size: 1.02rem; }
  .card-head a { color: var(--fg); text-decoration: none; }
  .card-head a:hover { color: var(--accent); }

  .card-summary {
    margin: 8px 0 14px;
    color: var(--fg-muted);
    font-size: 0.93rem;
  }

  .card-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
