---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../consts';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length > 0 ? featured : projects).slice(0, 6);
const hasMore = projects.length > shown.length;

const devices = [
  { name: 'Pixel 10 Pro', codename: 'blazer', forum: 'https://xdaforums.com/t/rom-official-16-0-crdroid-12-x-for-pixel-10-pro-pro-xl-blazer-mustang.4785628/' },
  { name: 'Pixel 5a', codename: 'barbet', forum: 'https://xdaforums.com/t/rom-official-13-14-15-crdroid-for-pixel-5a-barbet.4646786/' },
  { name: 'Pixel 5', codename: 'redfin', forum: 'https://xdaforums.com/t/rom-official-13-14-15-crdroid-for-pixel-5-redfin.4664665/' },
  { name: 'Pixel 4a 5G', codename: 'bramble', forum: 'https://xdaforums.com/t/rom-official-13-14-15-crdroid-for-pixel-4a5g-bramble.4664667/' },
];
---

<Base description={SITE.description}>
  <section class="intro">
    <p class="eyebrow">Android platform &amp; ROM maintenance</p>
    <h1>Bobby Panarisi</h1>
    <p class="lede">
      I maintain <a href="https://crdroid.net" rel="noopener">crDroid</a> for four Google
      Pixel devices — device trees, kernels, SELinux policy, and the build tooling that
      turns all of it into a signed monthly OTA.
    </p>
    <p>
      Most of that work lands upstream rather than in my own repositories —
      <a href="/projects/upstream-contributions/">43 pull requests</a> into crDroid's
      organisation, and platform patches that other ROMs have since picked up. Builds ship
      through crDroid's official channels, with
      <a href={SITE.gapps} rel="noopener">matching NikGapps packages</a> alongside them.
    </p>
  </section>

  <section class="devices">
    <h2>Officially maintained</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>Device</th><th>Codename</th><th>Thread</th></tr>
        </thead>
        <tbody>
          {devices.map((d) => (
            <tr>
              <td>{d.name}</td>
              <td><code>{d.codename}</code></td>
              <td><a href={d.forum} rel="noopener">XDA</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="meta note">All four on crDroid 12.x / Android 16, built monthly.</p>
  </section>

  <section>
    <div class="section-head">
      <h2>{featured.length > 0 ? 'Selected work' : 'Recent projects'}</h2>
      {hasMore && <a class="more" href="/projects/">All projects &rarr;</a>}
    </div>

    {shown.length === 0 ? (
      <p class="meta">No projects published yet.</p>
    ) : (
      <div class="grid">
        {shown.map((project) => <ProjectCard project={project} />)}
      </div>
    )}
  </section>
</Base>

<style>
  .intro { margin-bottom: 52px; }
  .lede {
    font-size: 1.05rem;
    color: var(--fg-muted);
    max-width: var(--measure);
  }

  .devices { margin-bottom: 52px; }
  .devices h2 { margin-bottom: 14px; }
  .devices td:first-child { white-space: nowrap; }
  .note { margin-top: 10px; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .section-head h2 { margin: 0; }
  .more { font-size: 0.88rem; text-decoration: none; }
  .more:hover { text-decoration: underline; }

  .grid { display: grid; gap: 14px; }
</style>
