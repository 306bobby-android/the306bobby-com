---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const SECTIONS = [
  {
    key: 'android' as const,
    title: 'Android',
    blurb: 'ROM maintenance, device bringup, and the platform work underneath it.',
  },
  {
    key: 'tooling' as const,
    title: 'Tooling',
    blurb: 'Things built to make the work above less tedious.',
  },
  {
    key: 'side' as const,
    title: 'Side projects',
    blurb: 'Everything else.',
  },
];

const sections = SECTIONS.map((s) => ({
  ...s,
  items: projects.filter((p) => p.data.category === s.key),
})).filter((s) => s.items.length > 0);
---

<Base title="Projects" description="Things I've built, ported, or keep alive.">
  <p class="eyebrow">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>
  <h1>Projects</h1>
  <p class="lede">Things I've built, ported, or keep alive.</p>

  {projects.length === 0 ? (
    <p class="meta">Nothing published yet.</p>
  ) : (
    sections.map((section) => (
      <section class="group">
        <div class="group-head">
          <h2>{section.title}</h2>
          <span class="meta">{section.items.length}</span>
        </div>
        <p class="group-blurb">{section.blurb}</p>
        <div class="grid">
          {section.items.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    ))
  )}
</Base>

<style>
  .lede { color: var(--fg-muted); max-width: var(--measure); margin-bottom: 44px; }

  .group { margin-bottom: 52px; }
  .group:last-child { margin-bottom: 0; }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 8px;
  }
  .group-head h2 { margin: 0; }

  .group-blurb {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 10px 0 18px;
    max-width: var(--measure);
  }

  .grid { display: grid; gap: 14px; }
</style>
