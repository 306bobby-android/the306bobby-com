---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, date, tags, repo, link, status } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <article>
    <header class="head">
      <p class="eyebrow">
        <a href="/projects/">Projects</a>
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>

      <div class="head-meta">
        <span class="badge" data-status={status}>{status}</span>
        <time class="meta" datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
        </time>
      </div>

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      )}

      {(repo || link) && (
        <p class="links">
          {repo && <a href={repo} rel="noopener">Source &rarr;</a>}
          {link && <a href={link} rel="noopener">Live &rarr;</a>}
        </p>
      )}
    </header>

    <hr />

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .head { margin-bottom: 8px; }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--accent); }

  .summary {
    font-size: 1.05rem;
    color: var(--fg-muted);
    max-width: var(--measure);
  }

  .head-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .links { display: flex; gap: 18px; margin-top: 16px; font-size: 0.9rem; }
</style>
